# =============================================================================
# Protin — STAGING environment (RX6600 server)
#
# Copy to .env.staging before deploying:
#   cp .env.staging.example .env.staging
#
# Replace all <placeholder> values with real values.
# Never commit .env.staging.
#
# Used by:
#   - docker-compose.staging.yml (postgres, redis, api, worker, nginx)
#   - infra/scripts/backup.sh
#   - infra/scripts/restore.sh
# =============================================================================


# --- Docker Compose: PostgreSQL -----------------------------------------------
POSTGRES_DB=protin
POSTGRES_USER=protin
POSTGRES_PASSWORD=<strong-random-password>

# Staging: postgres and redis ports are NOT exposed to the host (nginx is the
# only public entrypoint). These vars are kept for reference / local overrides.
POSTGRES_PORT=5432
REDIS_PORT=6379


# --- API ----------------------------------------------------------------------
APP_ENV=staging
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info

# Internal Docker network URLs — do not use localhost in staging.
POSTGRES_URL=postgresql://protin:<strong-random-password>@postgres:5432/protin
REDIS_URL=redis://redis:6379/0
# Docker bridge peers are the only processes allowed to supply forwarding
# headers to the non-published API service.
TRUSTED_PROXY_CIDRS=172.16.0.0/12

# JWT signing secret.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_ME

# Field-level encryption key for OAuth tokens at rest (Fernet / AES-256-GCM).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=GENERATE_ME

# Shared secret for internal-only endpoints such as /internal/process-notifications.
# REQUIRED in staging/production: the API refuses to boot when unset in those envs.
# Callers (cron, worker, healthcheck loops) must send it as the X-Internal-Token header.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_TOKEN=GENERATE_ME


# --- Google OAuth (optional — needed for Calendar integration) ----------------
GOOGLE_CLIENT_ID=<your-google-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
# Must match an authorised redirect URI in Google Cloud Console.
# Replace RX6600_IP with the server's LAN IP or hostname.
GOOGLE_REDIRECT_URI=http://RX6600_IP/users/me/google-calendar/callback


# --- Sign in with Apple (required for the /auth/apple endpoint) ---------------
# iOS bundle identifier (same value as apps/mobile/app.config.js → ios.bundleIdentifier).
# If unset, POST /auth/apple returns 503 Service Unavailable.
APPLE_CLIENT_ID=com.edh1223.protin


# --- Worker -------------------------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=60
