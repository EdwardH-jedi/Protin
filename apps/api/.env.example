# =============================================================================
# Protin API — environment variables
#
# Copy to apps/api/.env and fill in real values:
#   cp apps/api/.env.example apps/api/.env
#
# When running in Docker (staging), these are injected via docker-compose
# env_file or the compose environment block — do not mount this file directly.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=local                    # local | staging | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info                   # debug | info | warning | error

# ── Database ─────────────────────────────────────────────────────────────────
# For local dev: localhost. In Docker staging: use the service name (postgres).
POSTGRES_URL=postgresql://protin:protin@localhost:5432/protin

# ── Redis ────────────────────────────────────────────────────────────────────
# For local dev: localhost. In Docker staging: use the service name (redis).
REDIS_URL=redis://localhost:6379/0

# ── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED IN STAGING/PRODUCTION.
# Generate a strong random secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# ── Google Calendar OAuth ─────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/ → APIs & Services → Credentials
# Leave empty to disable Google Calendar integration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an authorised redirect URI registered in Google Cloud Console.
# Staging: https://<staging-host>/users/me/google-calendar/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/users/me/google-calendar/callback

# ── Google Places (New) — venue discovery (v1.1) ──────────────────────────────
# Enables the "Google-Maps-like" density for the in-app venue picker.
# Provision a key at https://console.cloud.google.com/ → APIs & Services →
# Credentials, enable "Places API (New)", then restrict the key to that API.
# Leave EMPTY to keep the v1.0 behaviour (local seed catalog only — provider
# returns [] without making any HTTP call).
GOOGLE_PLACES_API_KEY=

# ── Push Notifications (Expo) ─────────────────────────────────────────────────
# Default Expo push API — no changes needed unless you self-host.
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send

# ── Worker ───────────────────────────────────────────────────────────────────
# How often the notification worker polls for due notifications (seconds).
WORKER_POLL_INTERVAL_SECONDS=60
