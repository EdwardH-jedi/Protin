# =============================================================================
# Protin Mobile — environment variables
#
# Copy to apps/mobile/.env:
#   cp apps/mobile/.env.example apps/mobile/.env
#
# EXPO_PUBLIC_ prefix is required by Expo for variables accessible in JS.
# Variables without this prefix are only available in native config (app.config.js).
#
# Switch between environments:
#   Local:   copy .env.example → .env  (uses localhost)
#   Staging: copy .env.staging.example → .env  (uses RX6600 LAN IP or hostname)
# =============================================================================

# ── API connection ────────────────────────────────────────────────────────────
# URL of the Protin API. No trailing slash.
# Local dev:   http://localhost:8000
# Staging:     http://<rx6600-lan-ip>  (nginx on port 80)
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── Google OAuth redirect ─────────────────────────────────────────────────────
# Must match GOOGLE_REDIRECT_URI set in the API's .env and in Google Cloud Console.
# For local:   http://localhost:8000/users/me/google-calendar/callback
# For staging: http://<rx6600-lan-ip>/users/me/google-calendar/callback
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:8000/users/me/google-calendar/callback

# ── Legal / support URLs ──────────────────────────────────────────────────────
# Public URLs the in-app Privacy / Terms / Support links open. Read by
# `apps/mobile/src/lib/legal.ts` at runtime; the in-app affordances treat each
# link as "not available" if the corresponding variable is unset.
#
# These are PUBLIC URLs — not secrets — and are safe to commit in this example
# file. The values below point at the SportsGang official website deployed
# on Netlify (apps/web/site/, served from `https://sportgang.netlify.app/` —
# the Netlify hostname remains `sportgang.netlify.app` for v1; the public
# brand spelling is SportsGang).
#
# For preview / production EAS builds, the same values must be set via
# `eas env:create` on the matching EAS environment — see
# `docs/deployment/APPLE_TESTFLIGHT_PREP.md` §4.8 for the exact commands.
#
# Replace these with the final custom-domain URLs (e.g.
# `https://sportgang.app/privacy/`) if/when the operator pins one.
EXPO_PUBLIC_PRIVACY_URL=https://sportgang.netlify.app/privacy/
EXPO_PUBLIC_TERMS_URL=https://sportgang.netlify.app/terms/
EXPO_PUBLIC_SUPPORT_URL=https://sportgang.netlify.app/support/
