# =============================================================================
# Protin Mobile — environment variables
#
# Copy to apps/mobile/.env:
#   cp apps/mobile/.env.example apps/mobile/.env
#
# EXPO_PUBLIC_ prefix is required by Expo for variables accessible in JS.
# Variables without this prefix are only available in native config (app.config.js).
#
# Switch between environments:
#   Local:   copy .env.example → .env  (uses localhost)
#   Staging: copy .env.staging.example → .env  (uses RX6600 LAN IP or hostname)
# =============================================================================

# ── API connection ────────────────────────────────────────────────────────────
# URL of the Protin API. No trailing slash.
# Local dev:   http://localhost:8000
# Staging:     http://<rx6600-lan-ip>  (nginx on port 80)
EXPO_PUBLIC_API_URL=http://localhost:8000

# ── Google OAuth redirect ─────────────────────────────────────────────────────
# Must match GOOGLE_REDIRECT_URI set in the API's .env and in Google Cloud Console.
# For local:   http://localhost:8000/users/me/google-calendar/callback
# For staging: http://<rx6600-lan-ip>/users/me/google-calendar/callback
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=http://localhost:8000/users/me/google-calendar/callback
