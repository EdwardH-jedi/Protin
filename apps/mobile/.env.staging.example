# =============================================================================
# Protin Mobile — STAGING environment
#
# Copy to apps/mobile/.env for staging device testing:
#   cp apps/mobile/.env.staging.example apps/mobile/.env
#
# Replace RX6600_IP with the actual LAN IP of the RX6600 server
# (e.g. 192.168.1.x) or its hostname if your network has DNS.
#
# Devices testing against staging must be on the same LAN as the RX6600,
# or connected via a VPN/Tailscale tunnel.
# =============================================================================

EXPO_PUBLIC_API_URL=http://RX6600_IP
EXPO_PUBLIC_GOOGLE_REDIRECT_URI=http://RX6600_IP/users/me/google-calendar/callback

# ── Legal / support URLs ──────────────────────────────────────────────────────
# Public URLs the in-app Privacy / Terms / Support links open. Same values
# across local, staging, preview, and production until a final custom domain
# is pinned. These are public URLs and safe to commit in this example file.
# Production EAS builds must also have these set via `eas env:create`
# (see `docs/deployment/APPLE_TESTFLIGHT_PREP.md` §4.8).
EXPO_PUBLIC_PRIVACY_URL=https://sportgang.netlify.app/privacy/
EXPO_PUBLIC_TERMS_URL=https://sportgang.netlify.app/terms/
EXPO_PUBLIC_SUPPORT_URL=https://sportgang.netlify.app/support/
