[Unit]
Description=SportsGang staging health check (oneshot)
# Only run once docker is available; healthcheck.sh shells into compose.
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
# WorkingDirectory must be the repo root so docker compose picks up
# docker-compose.yml + docker-compose.staging.yml. Override these paths through
# a drop-in (systemctl edit sportsgang-healthcheck.service) if the repo lives
# somewhere other than /opt/sportsgang.
WorkingDirectory=/opt/sportsgang
ExecStart=/usr/bin/env bash /opt/sportsgang/infra/scripts/cron-health-check.sh
# Never mark the unit failed on a transient check miss — the wrapper
# script already writes failures to /var/log/sportsgang/health-failures.log
# and always exits 0.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
