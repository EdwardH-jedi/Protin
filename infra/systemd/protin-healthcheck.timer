[Unit]
Description=Run Protin staging health check every 5 minutes
# Pair with protin-healthcheck.service.

[Timer]
Unit=protin-healthcheck.service
# Matches the existing */5 * * * * cron cadence.
OnCalendar=*:0/5
# Catch up on a single missed run after downtime (power cycle, etc.)
# instead of waiting up to 5 minutes for the next tick.
Persistent=true
# Jitter so many timers don't fire exactly on the minute boundary.
AccuracySec=30s
RandomizedDelaySec=15s

[Install]
WantedBy=timers.target
